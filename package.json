{
  "name": "pregnancy-assistant-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "typecheck:miniprogram": "tsc -p miniprogram/tsconfig.json",
    "validate:miniprogram": "node scripts/validate-miniprogram.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && node --test server/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
