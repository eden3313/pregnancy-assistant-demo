<view class="page"><view class="header"><view><text class="eyebrow">仅保存在本机</text><view class="page-title">个人记录</view></view><button class="add-button" bindtap="add">＋</button></view><view class="muted">可保存文字和照片；照片文字整理结果需由你核对后保存。</view>
<button class="button-secondary" bindtap="scanReport">拍照整理报告文字</button>
<view wx:if="{{records.length}}"><view class="record" wx:for="{{records}}" wx:key="id"><view class="record-main" data-id="{{item.id}}" bindtap="edit"><image wx:if="{{item.photoPath}}" class="thumb" src="{{item.photoPath}}" mode="aspectFill"/><view class="record-copy"><view class="date">{{item.date}}</view><view class="title">{{item.title}}</view><view class="body">{{item.body || '暂无文字内容'}}</view></view></view><button class="delete" data-id="{{item.id}}" bindtap="remove">×</button></view></view><view class="empty" wx:else>还没有个人记录，点击右上角添加。</view></view>
