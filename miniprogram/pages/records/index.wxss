.header { display: flex; justify-content: space-between; align-items: center; }.add-button { width: 88rpx; height: 88rpx; line-height: 82rpx; padding: 0; border-radius: 50%; background: #4d7d68; color: white; font-size: 48rpx; }.record { display: flex; align-items: center; padding: 20rpx; margin-top: 18rpx; background: #fffdfb; border: 1rpx solid #e5e2dc; border-radius: 14rpx; }.record-main { display: flex; flex: 1; min-width: 0; }.thumb { width: 120rpx; height: 120rpx; border-radius: 10rpx; margin-right: 20rpx; }.record-copy { flex: 1; min-width: 0; }.date { color: #4d7d68; font-size: 24rpx; }.title { font-size: 32rpx; font-weight: 650; }.body { color: #6f7c76; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.delete { width: 60rpx; padding: 0; background: transparent; color: #9b716a; font-size: 40rpx; }
