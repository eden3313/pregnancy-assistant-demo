.header { display: flex; justify-content: space-between; align-items: center; }.add-button { width: 88rpx; height: 88rpx; line-height: 82rpx; padding: 0; border-radius: 50%; background: #4d7d68; color: white; font-size: 48rpx; }
.schedule-row { display: flex; align-items: flex-start; gap: 18rpx; padding: 24rpx 18rpx; margin-top: 18rpx; background: #fffdfb; border: 1rpx solid #e5e2dc; border-radius: 14rpx; }.check { flex: none; width: 42rpx; height: 42rpx; border: 2rpx solid #7ea18f; border-radius: 50%; text-align: center; line-height: 40rpx; color: #4d7d68; }.schedule-main { flex: 1; }.time { color: #4d7d68; font-size: 24rpx; }.type { margin-left: 12rpx; color: #8d7fb5; font-size: 22rpx; }.title { font-size: 32rpx; font-weight: 650; margin: 6rpx 0; }.delete { flex: none; width: 60rpx; padding: 0; background: transparent; color: #9b716a; font-size: 40rpx; }.completed { opacity: .58; }.completed .title { text-decoration: line-through; }
