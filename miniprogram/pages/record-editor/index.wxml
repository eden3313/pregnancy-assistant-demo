<view class="page"><view class="page-title">{{id ? '编辑记录' : '新增记录'}}</view><view class="field"><text class="label">日期</text><picker mode="date" value="{{date}}" data-field="date" bindchange="onInput"><view class="picker">{{date}}</view></picker></view><view class="field"><text class="label">标题</text><input class="input" data-field="title" value="{{title}}" bindinput="onInput" placeholder="例如：早孕超声报告"/></view><view class="field"><text class="label">标签</text><input class="input" data-field="tagsText" value="{{tagsText}}" bindinput="onInput" placeholder="用顿号分隔，例如：产检、超声"/></view>
<view class="card"><view class="section-title">本地照片附件</view><image wx:if="{{photoPath}}" class="preview" src="{{photoPath}}" mode="aspectFit"/><button class="button-secondary" bindtap="choosePhoto">{{photoPath ? '更换照片' : '选择照片'}}</button><view class="muted local-photo-note">照片仅作为当前设备上的个人记录附件。</view></view>
<view class="field"><text class="label">个人文字记录</text><textarea class="textarea body" maxlength="6000" data-field="body" value="{{body}}" bindinput="onInput" placeholder="手工填写需要保存的内容"/></view>
<button class="button-primary" bindtap="save">确认并保存到本机</button><view class="notice">仅用于个人记录整理，请以原报告和医生解释为准。</view></view>
